{
  "name": "@purrdle/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/server.js)",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --coverageReporters=text-summary"
  },
  "dependencies": {
    "@purrdle/shared": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.6.7"
  }
}
