# apps/api — copy to .env (never commit .env). Validated at startup by src/config.ts.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Cloud Run is behind Google's front end: trust one proxy hop for the client IP.
TRUST_PROXY=true

# AI judge (server-side only — never ship keys to the app)
JUDGE_PROVIDER=mock                 # mock | jev (jev client is a stub until its API format is confirmed)
JUDGE_CONFIDENCE_THRESHOLD=0.85
JUDGE_TIMEOUT_MS=2500
JUDGE_DAILY_BUDGET=2000             # max AI calls per UTC day across all players (cache hits are free)
JUDGE_CACHE_TTL_SECONDS=2592000     # 30 days
# JEV_API_KEY=
# JEV_MODEL=
# JEV_BASE_URL=https://openrouter.ai/api/v1

# Rate limits
RATE_LIMIT_DEVICE_PER_HOUR=30
RATE_LIMIT_IP_PER_MINUTE=120

# Upstash Redis (required in production; in-memory store is used when unset in dev)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
